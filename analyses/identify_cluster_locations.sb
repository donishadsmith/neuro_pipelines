#!/bin/bash
#SBATCH --job-name=identify_cluster_locations
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=48G
# Outputs ------------------------------------------------------------------------------------
#SBATCH --output=/projects/bigos_lab/mph-study/code/logs/identify_cluster_locations_%A_%a.out
#SBATCH --error=/projects/bigos_lab/mph-study/code/logs/identify_cluster_locations_%A_%a.err
# --------------------------------------------------------------------------------------------
BAD_NODES_FILE="/projects/bigos_lab/mph-study/code/logs/bad_nodes_${SLURM_ARRAY_JOB_ID}.txt"

if ! getent passwd $(id -u) > /dev/null 2>&1; then
    echo $(hostname) >> $BAD_NODES_FILE
    sort -u -o $BAD_NODES_FILE $BAD_NODES_FILE
    echo "Can't determine user account information on $(hostname). Requeueing job"
    SCONTROL_STRING="update JobId=${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} ExcNodeList=$(paste -sd, $BAD_NODES_FILE)"
    scontrol requeue ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}
    scontrol $SCONTROL_STRING
    exit 0
fi

ANALYSIS_TYPE=${ANALYSIS_TYPE:-glm} # glm or gPPI
METHOD=${METHOD:-parametric}
WHEREAMI_ATLAS=${WHEREAMI_ATLAS:-"FS.afni.MNI2009c_asym"}

COHORT=${COHORT:-"kids"}                            # Choose "kids" or "adults"
BIDS_DIR="/projects/bigos_lab/mph-study/$COHORT/dset"
PYTHON="/projects/bigos_lab/envs/py313/bin/python"
AFNI_IMG_PATH="/projects/bigos_lab/apptainer-images/afni-26.1.02.simg"

DEFAULT_TASKS=("nback" "mtle" "mtlr" "princess" "flanker")

# sbatch --array=0 identify_cluster_locations.sb # values map to SLURM_ARRAY_TASK_ID for indexing TASK array
TASKS=( $@ )
# slurm job value; essentially extracting sub-{id}
if [ ${#TASKS[@]} -eq 0 ]; then
    TASK=${DEFAULT_TASKS[${SLURM_ARRAY_TASK_ID}]}
else
	TASK=${TASKS[${SLURM_ARRAY_TASK_ID}]}
fi

ANALYSIS_DIR="$BIDS_DIR/derivatives/$ANALYSIS_TYPE/$TASK"
SCRATCH_DIR="/scratch/$USER/mph/kids/mni_coordinate_files"
mkdir -p $SCRATCH_DIR

CMD="$PYTHON identify_cluster_locations.py \
    --analysis_dir $ANALYSIS_DIR \
    --scratch_dir $SCRATCH_DIR \
	--afni_img_path $AFNI_IMG_PATH \
    --cohort $COHORT \
	--task $TASK \
    --method $METHOD \
    --atlas $WHEREAMI_ATLAS \
    --analysis_type $ANALYSIS_TYPE"

echo Task ID: $SLURM_ARRAY_TASK_ID
echo Commandline: $CMD
eval $CMD
EXITCODE=$?

echo Exit Code: $EXITCODE
date
exit $EXITCODE
